# App
ENVIRONMENT=development
PORT=8000

# CORS — comma-separated origins allowed to call this API from a browser (the
# frontend's dev server or deployed URL). Defaults to the standard local Vite ports.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database — Supabase Postgres with pgvector.
# DATABASE_URL: used by `python -m db.migrate` to create extensions, roles and tables.
# On Supabase this is the default `postgres` connection string (owns the schema).
DATABASE_URL=postgresql://postgres:password@localhost:5432/autonomous_sdr

# APP_DATABASE_URL: what the API and worker actually connect as at runtime — the
# `app_user` role created by 0001_extensions_and_roles.sql, which does NOT bypass row-
# level security. Falls back to DATABASE_URL if unset, but never do that in production:
# see docs/spec.md section 5, enforcement layer 3. Set app_user's password once after
# migrating (`ALTER ROLE app_user WITH PASSWORD '...';`, run out of band — never commit it).
APP_DATABASE_URL=postgresql://app_user:password@localhost:5432/autonomous_sdr

# Secrets at rest — base64-encoded 32-byte AES-256-GCM key used to encrypt integration
# credentials (backend/tenancy/crypto.py). Generate one with:
#   python -c "from tenancy.crypto import generate_secrets_key as g; print(g())"
SECRETS_KEY=

# LLM wrapper (backend/ai) — one OpenAI-compatible provider. Using Gemini's free-tier
# OpenAI-compatible endpoint (docs/spec.md section on LLM wrapper): get a free key at
# https://aistudio.google.com/apikey. Flash and Pro both have a free tier; keep an eye
# on https://aistudio.google.com/rate-limit for current RPM/RPD limits.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
MODEL_SMALL=gemini-3.8-flash
MODEL_STRONG=gemini-2.5-pro
EMBED_MODEL=gemini-embedding-001

# ICP discovery agent (api/dronahq_discovery.py). Left unset, "Discover prospects"
# never calls out over the network at all - it draws from the synthetic dataset in
# docs/prospects.json instead (api/prospects.py's simulate_discovery fallback). Point
# this at a real DronaHQ webhook once one is deployed.
DRONAHQ_ICP_DISCOVERY_WEBHOOK_URL=
